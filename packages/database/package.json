    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@ustal/config": "*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
