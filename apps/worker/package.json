    "@ustal/domain": "*",
    "@ustal/matching": "*",
    "@ustal/ontology": "*",
    "@ustal/queue": "*",
    "@ustal/storage": "*",
    "@ustal/validation": "*",
    "pg-boss": "^9.0.3",
    "pino": "^9.3.2",
    "tsx": "^4.16.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
