{
  "name": "ustal",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate -w @ustal/database",
    "db:migrate": "npm run db:migrate -w @ustal/database",
    "db:seed": "npm run db:seed -w @ustal/database",
    "db:seed-admin": "npm run db:seed-admin -w @ustal/database",
    "dev:api": "npm run dev -w @ustal/api",
    "dev:worker": "npm run dev -w @ustal/worker",
    "dev:admin": "npm run dev -w @ustal/admin",
    "dev:mobile": "npm run start -w @ustal/mobile",
    "blind:verify-isolation": "npm run blind:verify-isolation -w @ustal/blind-evaluation",
    "blind:setup-db": "npm run blind:setup-db -w @ustal/blind-evaluation",
    "blind:load-data": "npm run blind:load-data -w @ustal/blind-evaluation",
    "blind:evaluate": "npm run blind:evaluate -w @ustal/blind-evaluation --",
    "blind:analyze": "npm run blind:analyze -w @ustal/blind-evaluation"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.5.4"
  }
}