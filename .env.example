# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database (self-hosted Postgres + pgvector, e.g. on Timeweb Cloud) ---
DATABASE_URL=postgres://ustal:ustal@localhost:5432/ustal

# --- Auth ---
JWT_ACCESS_SECRET=change-me-local-access-secret
JWT_REFRESH_SECRET=change-me-local-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI provider ---
# mock — для локальной разработки/тестов, без сетевых вызовов и ключей.
# openai — боевой провайдер (нужен OPENAI_API_KEY), см. docs/architecture.md раздел 2.
AI_PROVIDER=mock
# Explicit coordinated API/worker activation only AFTER a real approved disclosure.
USTAL_AI_CONSENT_MODE=off
USTAL_AI_CONSENT_PURPOSE=
OPENAI_API_KEY=
# Required in production with AI_PROVIDER=openai. Do not route Russian backend
# directly to api.openai.com; use the protected Timeweb EU relay:
# OPENAI_BASE_URL=https://ai-relay.example.com/v1
OPENAI_BASE_URL=

# --- Хранилище медиа (см. docs/architecture.md, добавление #10) ---
# local — пишет файлы на диск процесса api (только для разработки).
# s3 — Timeweb Cloud Object Storage (S3-совместимое), см. OBJECT_STORAGE_*.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=./data/media
AI_MODEL_EXTRACTION=gpt-4o-mini
AI_MODEL_MODERATION=gpt-4o-mini
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_MODEL_STT=whisper-1

# --- Object storage (photos, audio) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=ustal-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Push notifications ---
EXPO_ACCESS_TOKEN=
PUSH_PROVIDER=mock

# --- Rate limits / config (see packages/config) ---
PROFILE_FREEFORM_EDITS_PER_HOUR=10
PROFILE_ITEM_ACTIONS_PER_HOUR=30
# Phase 1 profile_facts (SHADOW): separate per-input fact extraction; never used by matching. enabled|disabled
PROFILE_FACTS_EXTRACTION=enabled
CONTACT_UNLOCKS_PER_HOUR=30
# Число доверенных reverse-proxy перед API; локально 0 (X-Forwarded-For игнорируется).
TRUST_PROXY_HOPS=0

# --- Подтверждение телефона (OTP) ---
# disabled — по умолчанию, регистрация без SMS (dev/ранний запуск MVP).
# required_for_new — новые регистрации обязаны подтвердить номер; старым
# пользователям подтверждение только предлагается при входе, не блокирует.
PHONE_VERIFICATION_MODE=disabled
# Только "mock" реализован. Мок ничего не отправляет реально — только лог/dev.
# В production запрещён, если PHONE_VERIFICATION_MODE != disabled (см. packages/config).
SMS_PROVIDER=mock
# Нужен, только если PHONE_VERIFICATION_MODE != disabled.
PHONE_VERIFICATION_SECRET=change-me-32-plus-chars-phone-verification-secret

# --- Admin ---
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me
# Только для `npm run db:seed-admin` (packages/database/src/seed-admin.ts,
# Фаза 8) — создаёт ровно одного dev-администратора, если такого email ещё
# нет. НЕ часть рантайм-схемы @ustal/config (читается напрямую из process.env
# в самом скрипте, не через loadEnv()) — не нужен для запуска api/worker/admin.
# Значения ниже — только для локальной разработки, смените перед боевым
# использованием.
ADMIN_SEED_EMAIL=admin@ustal.local
ADMIN_SEED_PASSWORD=admin-dev-password-change-me

# --- API ---
# Обращения в поддержку из приложения (POST /support). Пусто — форма отвечает «временно недоступно».
SUPPORT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
API_PORT=4000
ADMIN_PORT=4100

# Production template: infra/timeweb/app/.env.example
AI_MODEL_NORMALIZATION=gpt-4.1-mini
AI_MODEL_SEMANTIC_REVIEW=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
ORDERS_PER_HOUR=20
REPORTS_PER_HOUR=20
MEDIA_UPLOADS_PER_HOUR=30
MEDIA_STORAGE_MAX_BYTES_PER_USER=524288000
OTP_CODE_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_REQUESTS_PER_PHONE_PER_DAY=5

# Staged registration-only age self-declaration; existing login/refresh are unaffected.
USTAL_REGISTRATION_AGE_MODE=compatibility
