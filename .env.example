# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database (self-hosted Postgres + pgvector, e.g. on Timeweb Cloud) ---
DATABASE_URL=postgres://ustal:ustal@localhost:5432/ustal

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- AI provider ---
# mock — для локальной разработки/тестов, без сетевых вызовов и ключей.
# openai — боевой провайдер (нужен OPENAI_API_KEY), см. docs/architecture.md раздел 2.
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- Хранилище медиа (см. docs/architecture.md, добавление #10) ---
# local — пишет файлы на диск процесса api (только для разработки).
# s3 — Timeweb Cloud Object Storage (S3-совместимое), см. OBJECT_STORAGE_*.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=./data/media
AI_MODEL_EXTRACTION=gpt-4o-mini
AI_MODEL_MODERATION=gpt-4o-mini
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_MODEL_STT=whisper-1

# --- Object storage (photos, audio) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=ustal-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Push notifications ---
EXPO_ACCESS_TOKEN=
PUSH_PROVIDER=mock

# --- Rate limits / config (see packages/config) ---
PROFILE_FREEFORM_EDITS_PER_HOUR=15
CONTACT_UNLOCKS_PER_HOUR=30

# --- Admin ---
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me
# Только для `npm run db:seed-admin` (packages/database/src/seed-admin.ts,
# Фаза 8) — создаёт ровно одного dev-администратора, если такого email ещё
# нет. НЕ часть рантайм-схемы @ustal/config (читается напрямую из process.env
# в самом скрипте, не через loadEnv()) — не нужен для запуска api/worker/admin.
# Значения ниже — только для локальной разработки, смените перед боевым
# использованием.
ADMIN_SEED_EMAIL=admin@ustal.local
ADMIN_SEED_PASSWORD=admin-dev-password-change-me

# --- API ---
API_PORT=4000
ADMIN_PORT=4100
