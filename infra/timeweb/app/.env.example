POSTGRES_USER=ustal
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=ustal

ACME_EMAIL=admin@example.com
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com

NODE_ENV=production
LOG_LEVEL=info

JWT_ACCESS_SECRET=change-me-32-plus-chars-access-secret
JWT_REFRESH_SECRET=change-me-32-plus-chars-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

AI_PROVIDER=openai
# This is the relay client token, not the real OpenAI key.
OPENAI_API_KEY=change-me-same-value-as-relay-client-token
OPENAI_BASE_URL=https://ai-relay.example.com/v1
AI_MODEL_EXTRACTION=gpt-4o-mini
AI_MODEL_MODERATION=gpt-4o-mini
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_MODEL_STT=whisper-1

MEDIA_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=https://s3.timeweb.cloud
OBJECT_STORAGE_BUCKET=ustal-media
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=change-me

PROFILE_FREEFORM_EDITS_PER_HOUR=15
CONTACT_UNLOCKS_PER_HOUR=30

ADMIN_SESSION_SECRET=change-me-32-plus-chars-admin-session-secret
ADMIN_SEED_EMAIL=admin@ustal.local
ADMIN_SEED_PASSWORD=change-me-before-seed

API_PORT=4000
ADMIN_PORT=4100
