POSTGRES_USER=ustal
POSTGRES_PASSWORD=<SET_ME>
POSTGRES_DB=ustal

ACME_EMAIL=<SET_ME>
API_DOMAIN=<SET_ME>
ADMIN_DOMAIN=<SET_ME>

NODE_ENV=production
LOG_LEVEL=info

JWT_ACCESS_SECRET=<SET_ME>
JWT_REFRESH_SECRET=<SET_ME>
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

AI_PROVIDER=openai
# This is the relay client token, not the real OpenAI key.
OPENAI_API_KEY=<SET_ME>
OPENAI_BASE_URL=<SET_ME>
AI_MODEL_EXTRACTION=gpt-4o-mini
AI_MODEL_MODERATION=gpt-4o-mini
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_MODEL_STT=whisper-1

MEDIA_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=https://s3.timeweb.cloud
OBJECT_STORAGE_BUCKET=ustal-media
OBJECT_STORAGE_ACCESS_KEY=<SET_ME>
OBJECT_STORAGE_SECRET_KEY=<SET_ME>

PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

PROFILE_FREEFORM_EDITS_PER_HOUR=15
CONTACT_UNLOCKS_PER_HOUR=30
# Число доверенных прокси перед API (Caddy = 1). В docker-compose.prod.yml задано жёстко.
TRUST_PROXY_HOPS=1

# --- Подтверждение телефона (OTP) ---
# disabled — по умолчанию, регистрация без SMS (dev/ранний запуск MVP).
# required_for_new — новые регистрации обязаны подтвердить номер; старым
# пользователям подтверждение только предлагается при входе, не блокирует.
PHONE_VERIFICATION_MODE=disabled
# Только "mock" реализован. Мок ничего не отправляет реально — только лог/dev.
# В production запрещён, если PHONE_VERIFICATION_MODE != disabled (см. packages/config).
SMS_PROVIDER=mock
# Нужен, только если PHONE_VERIFICATION_MODE != disabled.
# PHONE_VERIFICATION_SECRET is not needed while verification is disabled.

ADMIN_SESSION_SECRET=<SET_ME>
ADMIN_SEED_EMAIL=<SET_ME>
ADMIN_SEED_PASSWORD=<SET_ME>

API_PORT=4000
ADMIN_PORT=4100

AI_MODEL_NORMALIZATION=gpt-4.1-mini
AI_MODEL_SEMANTIC_REVIEW=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
ORDERS_PER_HOUR=20
REPORTS_PER_HOUR=20
MEDIA_UPLOADS_PER_HOUR=30
MEDIA_STORAGE_MAX_BYTES_PER_USER=524288000

# DATABASE_URL is constructed by Compose; POSTGRES_PASSWORD must be URL-safe.
# Use a password manager value containing only A-Z, a-z, 0-9, _ and -.
# EXPO_ACCESS_TOKEN: set only if Expo push enhanced security is enabled.
OTP_CODE_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_REQUESTS_PER_PHONE_PER_DAY=5
